 void BluetoothHci::sendHciCommand(const std::vector<uint8_t>& packet) {
+    if (packet.size() >= 2) {
+        uint16_t opcode = packet[0] | (packet[1] << 8);
+        if ((opcode >> 10) == 0x3f) {
+            std::lock_guard<std::mutex> guard(mVendorCmdMutex);
+            mPendingVendorCmds[opcode]++;
+        }
+    }
     return send(PacketType::COMMAND, packet);
 }
 
+bool BluetoothHci::isUnexpectedVendorResponse(const std::vector<uint8_t>& event) {
+    uint16_t opcode;
+    if (event.size() >= 5 && event[0] == 0x0e) {
+        opcode = event[3] | (event[4] << 8);
+    } else if (event.size() >= 6 && event[0] == 0x0f) {
+        opcode = event[4] | (event[5] << 8);
+    } else {
+        return false;
+    }
+    if ((opcode >> 10) != 0x3f) return false;
+
+    std::lock_guard<std::mutex> guard(mVendorCmdMutex);
+    auto it = mPendingVendorCmds.find(opcode);
+    if (it == mPendingVendorCmds.end()) {
+        ALOGW("Dropping unexpected event 0x%02x for opcode 0x%04x", event[0], opcode);
+        return true;
+    }
+    if (--it->second == 0) mPendingVendorCmds.erase(it);
+    return false;
+}
