+auto DrmFbIdHandle::CreateHostOrderInstance(BufferInfo *bo,
+                                            GemHandle src_gem_handle,
+                                            uint32_t scanout_format,
+                                            DrmDevice &drm)
+    -> std::shared_ptr<DrmFbIdHandle> {
+  ATRACE_NAME("Create host order scanout buffer");
+
+  std::shared_ptr<DrmFbIdHandle> local(new DrmFbIdHandle(drm));
+  local->src_gem_handle_ = src_gem_handle;
+  const int fd = *drm.GetFd();
+
+  if (bo->modifiers[0] != DRM_FORMAT_MOD_NONE &&
+      bo->modifiers[0] != DRM_FORMAT_MOD_INVALID) {
+    ALOGE("Host order scanout requires a linear buffer");
+    return {};
+  }
+
+  struct drm_mode_map_dumb src_map = {.handle = src_gem_handle};
+  if (drmIoctl(fd, DRM_IOCTL_MODE_MAP_DUMB, &src_map) != 0) {
+    ALOGE("Failed to map scanout source buffer %d", errno);
+    return {};
+  }
+  local->src_map_size_ = static_cast<size_t>(bo->offsets[0]) +
+                         (static_cast<size_t>(bo->pitches[0]) * bo->height);
+  void *src = mmap(nullptr, local->src_map_size_, PROT_READ, MAP_SHARED, fd,
+                   static_cast<off_t>(src_map.offset));
+  if (src == MAP_FAILED) {
+    ALOGE("Failed to mmap scanout source buffer %d", errno);
+    return {};
+  }
+  local->src_map_ = src;
+
+  struct drm_mode_create_dumb create = {
+      .height = bo->height,
+      .width = bo->width,
+      .bpp = 32,
+      .flags = 0,
+  };
+  if (drmIoctl(fd, DRM_IOCTL_MODE_CREATE_DUMB, &create) != 0) {
+    ALOGE("Failed to create host order scanout buffer %d", errno);
+    return {};
+  }
+  local->gem_handles_[0] = create.handle;
+  local->dst_pitch_ = create.pitch;
+  local->dst_map_size_ = create.size;
+
+  struct drm_mode_map_dumb dst_map = {.handle = create.handle};
+  if (drmIoctl(fd, DRM_IOCTL_MODE_MAP_DUMB, &dst_map) != 0) {
+    ALOGE("Failed to map host order scanout buffer %d", errno);
+    return {};
+  }
+  void *dst = mmap(nullptr, local->dst_map_size_, PROT_READ | PROT_WRITE,
+                   MAP_SHARED, fd, static_cast<off_t>(dst_map.offset));
+  if (dst == MAP_FAILED) {
+    ALOGE("Failed to mmap host order scanout buffer %d", errno);
+    return {};
+  }
+  local->dst_map_ = dst;
+
+  local->width_ = bo->width;
+  local->height_ = bo->height;
+  local->src_pitch_ = bo->pitches[0];
+  local->src_offset_ = bo->offsets[0];
+
+  const std::array<uint32_t, kBufferMaxPlanes> pitches = {create.pitch};
+  const std::array<uint32_t, kBufferMaxPlanes> offsets = {};
+  if (drmModeAddFB2(fd, bo->width, bo->height, scanout_format,
+                    local->gem_handles_.data(), pitches.data(), offsets.data(),
+                    &local->fb_id_, 0) != 0) {
+    ALOGE("Failed to create host order scanout fb %d", errno);
+    return {};
+  }
+
+  local->scanout_format_ = scanout_format;
+  bo->format = scanout_format;
+  return local;
+}
+
+void DrmFbIdHandle::PrepareForScanout(const SharedFd &acquire_fence) const {
+  if (src_map_ == nullptr || dst_map_ == nullptr) {
+    return;
+  }
+
+  ATRACE_NAME("Convert scanout buffer to host order");
+
+  constexpr int kFenceTimeoutMs = 1000;
+  if (acquire_fence && *acquire_fence >= 0 &&
+      sync_wait(*acquire_fence, kFenceTimeoutMs) != 0) {
+    ALOGW("Timed out waiting for scanout source buffer");
+  }
+
+  const auto *src = static_cast<const uint8_t *>(src_map_) + src_offset_;
+  auto *dst = static_cast<uint8_t *>(dst_map_);
+  for (uint32_t y = 0; y < height_; y++) {
+    const auto *src_row = reinterpret_cast<const uint32_t *>(
+        src + (static_cast<size_t>(y) * src_pitch_));
+    auto *dst_row = reinterpret_cast<uint32_t *>(
+        dst + (static_cast<size_t>(y) * dst_pitch_));
+    for (uint32_t x = 0; x < width_; x++) {
+      const uint32_t pixel = src_row[x];
+      dst_row[x] = (pixel & 0xFF00FF00U) | ((pixel >> 16U) & 0xFFU) |
+                   ((pixel & 0xFFU) << 16U);
+    }
+  }
+}
+
